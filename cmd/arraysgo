func array2() {

	a := [...]int{1, 2}

	fmt.Println("len:", len(a))
	fmt.Println("cap:", cap(a))
	fmt.Println(a)

}

func array3() {

	// el tamaño es su tipo
	var b [3]int
	a := [3]int{1, 2, 3}
	fmt.Println(a)

	a = [3]int{5, 6, 7}
	fmt.Println(a)

	b = [...]int{8, 9, 10}
