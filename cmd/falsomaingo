func mteEtm(dstEnc, dstDec, src []byte, info *suite.SuiteInfo) ([]byte, []byte) {

	if info == nil {
		fmt.Println("metETM nil info")
		return nil, nil
	}

	key := claves(info.KeySize)
	ivKey := claves(info.IVSize)
	//dstEnc, err := aesCBCEncrypt2(dstEnc, src, key, ivKey)
	dstEnc, err := aesCBCEncrypt2(dstEnc, src, key, ivKey)
	if err != nil {
		fmt.Println("encrypt err |", err)
		return nil, nil
	}

	fmt.Printf("ciphered: %x\n", dstEnc)
	//return dstEnc, nil
	dstDec, err = aesCBCDecrypt2(dstDec, dstEnc, key, ivKey)
	if err != nil {
		fmt.Println("decrypt err:", err)
		return nil, nil
	}

	return dstEnc, dstDec
}

func aesCBCDecrypt2(dst, src, key, iv []byte) ([]byte, error) {

	if cap(dst) < len(src) {
		return nil, fmt.Errorf("dstLen does not meet requiredLen: %v vs %v",
			cap(dst), len(src))
	}

	dst = dst[:len(src)]
	block, err := aes.NewCipher(key)
	if err != nil {
		return nil, err
	}

	syphonFilter := cipher.NewCBCDecrypter(block, iv)
	syphonFilter.CryptBlocks(dst, src)
	if len(dst) == 0 {
		return nil, fmt.Errorf("cbc decrypt data is empty")
	}

	paddingLen := int(dst[len(dst)-1])
	if paddingLen > len(dst) {
		return nil, fmt.Errorf("cbc decrypt invalid padding len")
	}

	return dst[:len(dst)-(paddingLen)-1], nil
}

func aesCBCEncrypt2(dst, src, key, iv []byte) ([]byte, error) {

	padLen := aes.BlockSize - (len(src) % aes.BlockSize)
	requiredLen := len(src) + padLen
	if cap(dst) < requiredLen {
		return nil, fmt.Errorf("dstLen does not meet requiredLen: %v vs %v",
			cap(dst), requiredLen)
	}

	dst = dst[:requiredLen]
	copy(dst, src)
	padding := dst[len(src):]
	padByte := byte(padLen - 1)
	for i := range padding {
		padding[i] = padByte
	}

	block, err := aes.NewCipher(key)
	if err != nil {
		return nil, err
	}

	syphonFilter := cipher.NewCBCEncrypter(block, iv)
	syphonFilter.CryptBlocks(dst, dst)
	return dst, nil
}

func claves(sz int) []byte {

	key := make([]byte, sz)
	if _, err := rand.Read(key); err != nil {
		fmt.Printf("error generando key sz (%v): %v\n", sz, err)
		os.Exit(1)
	}

	return key
}
